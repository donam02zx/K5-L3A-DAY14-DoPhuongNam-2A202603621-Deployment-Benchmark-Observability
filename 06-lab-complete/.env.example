# Copy thành .env rồi điền giá trị thật:  cp .env.example .env
# .env đã nằm trong .gitignore — KHÔNG commit secret.

# Server
PORT=8000
# development | staging | production
ENVIRONMENT=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Security — bắt buộc; ENVIRONMENT=production mà để trống thì app không khởi động
# Tạo key: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# Redis — rate limit + cost guard (docker-compose tự đặt redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

# Giới hạn
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
